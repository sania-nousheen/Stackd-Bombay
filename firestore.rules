rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default deny all unmapped documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'sanianousheen35@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSiteMedia(data) {
      return data.mediaId is string && data.mediaId.size() <= 64 &&
             data.url is string && data.url.size() <= 2097152 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidReelItem(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 120 &&
             data.videoUrl is string && data.videoUrl.size() <= 2097152 &&
             (!('reviewer' in data) || (data.reviewer is string && data.reviewer.size() <= 120)) &&
             (!('quote' in data) || (data.quote is string && data.quote.size() <= 500)) &&
             (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 500)) &&
             (!('poster' in data) || (data.poster is string && data.poster.size() <= 2097152)) &&
             (!('order' in data) || data.order is number) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidAdminDoc(data) {
      return data.email is string && data.email.size() <= 128 &&
             data.role is string && data.role.size() <= 32 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 128));
    }

    // Public website media (About founder image, Philosophy image, Keepsake tin image)
    match /site_media/{mediaId} {
      allow get, list: if true;
      allow create, update: if isVerifiedAdmin() && isValidId(mediaId) && isValidSiteMedia(incoming());
      allow delete: if isVerifiedAdmin() && isValidId(mediaId);
    }

    // Public Customer Reviews / Vertical Reel Wall
    match /reels/{reelId} {
      allow get, list: if true;
      allow create, update: if isVerifiedAdmin() && isValidId(reelId) && isValidReelItem(incoming());
      allow delete: if isVerifiedAdmin() && isValidId(reelId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isVerifiedAdmin();
      allow write: if isVerifiedAdmin() && isValidId(adminId) && isValidAdminDoc(incoming());
    }
  }
}
